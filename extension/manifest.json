{
  "manifest_version": 3,
  "name": "nbrsflow Download Catcher",
  "version": "0.2.11",
  "description": "Intercept browser downloads and direct links and send them directly to nbrsflow (aria2).",
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "contextMenus",
    "cookies",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "nbrsflow",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
